# Copy to .env and fill in. .env is git-ignored.

# ntfy (see README "Notification setup"). Without a topic, alerts are only logged.
# Anyone who knows the topic name can read your alerts, so make it long and random.
NTFY_TOPIC=
# Only change/set these if you self-host ntfy or use a protected topic.
NTFY_SERVER=https://ntfy.sh
NTFY_TOKEN=

# Tix event slug and organiser (Group Therapy) ID - both verified on 2026-11-14.
TIX_EVENT_SLUG=klub-aniko
TIX_ORGANISER_ID=VXNlci04MTUxMDUwMC1hMjEzLTQ3NmYtOTI4Ny1lNzJjZjU0ZDE3MGU=

# Seconds between checks (a little random jitter is added).
POLL_SECONDS=45

# false = a visible Chrome window (works). true = invisible Chrome, which Tix's
# Cloudflare rejected when tested on 2026-11-14 - leave this false.
HEADLESS=false
