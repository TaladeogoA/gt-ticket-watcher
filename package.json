{
  "name": "gt-ticket-watcher",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "once": "tsx --env-file-if-exists=.env src/index.ts --once",
    "test-notify": "tsx --env-file-if-exists=.env src/index.ts --test-notify",
    "simulate-release": "tsx --env-file-if-exists=.env src/index.ts --simulate-release",
    "selftest": "tsx src/selftest.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "playwright-core": "^1.48.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
